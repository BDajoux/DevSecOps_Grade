# Basic hardening: block xmlrpc, readme, and wp-cron
<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to xmlrpc.php
RewriteRule ^xmlrpc\.php$ - [F,L]

# Block author ID enumeration (e.g., ?author=1)
RewriteCond %{QUERY_STRING} (^|&)author=\d+(&|$) [NC]
RewriteRule .* - [F,L]

# Block REST API users endpoint via query string (?rest_route=/wp/v2/users)
RewriteCond %{QUERY_STRING} rest_route=(/|%2F)wp(/|%2F)v2(/|%2F)users [NC]
RewriteRule .* - [F,L]

# Block REST API users endpoint (permalink) and user sitemaps
RewriteRule ^wp-json/wp/v2/users - [F,L]
RewriteRule ^wp-sitemap-users-.*\.xml$ - [F,L]
</IfModule>

<Files "readme.html">
Require all denied
</Files>

<Files "wp-cron.php">
Require all denied
</Files>
